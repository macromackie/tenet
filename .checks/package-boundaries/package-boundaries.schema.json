{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package dependency boundaries",
  "type": "object",
  "additionalProperties": false,
  "required": ["packages", "exclusions"],
  "properties": {
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "manifest",
        "manager",
        "ownership",
        "dependencies",
        "testSources",
        "testSupport",
        "tsconfig",
        "builtins"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "manager": {
          "enum": ["cargo", "npm"]
        },
        "ownership": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "testSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testSupport": {
          "type": "boolean"
        },
        "tsconfig": {
          "type": "string"
        },
        "builtins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest", "testOnly"],
            "properties": {
              "manifest": {
                "type": "string",
                "minLength": 1
              },
              "testOnly": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
