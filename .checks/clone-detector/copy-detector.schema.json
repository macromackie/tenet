{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned native source clone check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detectorVersion",
    "minTokens",
    "minLines",
    "sourceRoots",
    "sourceFiles",
    "formats",
    "extensionlessSources",
    "exclusions"
  ],
  "properties": {
    "detectorVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minTokens": {
      "type": "integer",
      "minimum": 1
    },
    "minLines": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formats": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["bash", "css", "javascript", "jsx", "python", "rust", "scss", "tsx", "typescript"]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^\\.[^./]+$"
        }
      }
    },
    "extensionlessSources": {
      "const": "shebang"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
