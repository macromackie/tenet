    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "es2024"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.mts"
  ]
