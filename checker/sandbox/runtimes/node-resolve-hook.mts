const HOOK_LINES = [
  'import { readFileSync, statSync } from "node:fs";',
  'import * as mod from "node:module";',
  'import { dirname, resolve as resolvePath, sep } from "node:path";',
  'import { fileURLToPath, pathToFileURL } from "node:url";',
  'const TS_SUFFIXES = [".ts", ".mts", ".cts", ".tsx"];',
  'const SUFFIXES = ["", ".ts", ".mts", ".cts", ".tsx", ".js", ".mjs", ".cjs", "/index.ts", "/index.mts", "/index.cts", "/index.tsx", "/index.js", "/index.mjs", "/index.cjs"];',
  String.raw`const JS_EXT_RE = /\.(?:m|c)?js$/;`,
  String.raw`const SPEC_RE = /^(?:(type)\s+)?([A-Za-z_$][\w$]*)(?:\s+as\s+([A-Za-z_$][\w$]*))?$/;`,
  String.raw`const LOCAL_TYPE_RE = /(?:^|\n)[ \t]*(?:export[ \t]+)?(?:declare[ \t]+)?(?:interface|type)[ \t]+([A-Za-z_$][\w$]*)/g;`,
  String.raw`const LOCAL_VALUE_RE = /(?:^|\n)[ \t]*(?:export[ \t]+)?(?:declare[ \t]+)?(?:(?:async[ \t]+)?function\*?|(?:abstract[ \t]+)?class|(?:const[ \t]+)?enum|const|let|var|namespace)[ \t]+([A-Za-z_$][\w$]*)/g;`,
  String.raw`const EXPORT_TYPE_DECL_RE = /(?:^|\n)[ \t]*export[ \t]+(?:declare[ \t]+)?(?:interface|type)[ \t]+([A-Za-z_$][\w$]*)/g;`,
  String.raw`const EXPORT_VALUE_DECL_RE = /(?:^|\n)[ \t]*export[ \t]+(?:declare[ \t]+)?(?:(?:async[ \t]+)?function\*?|(?:abstract[ \t]+)?class|(?:const[ \t]+)?enum|const|let|var|namespace)[ \t]+([A-Za-z_$][\w$]*)/g;`,
  String.raw`const EXPORT_DEFAULT_RE = /(?:^|\n)[ \t]*export[ \t]+default\b/;`,
  String.raw`const EXPORT_NS_RE = /(?:^|\n)[ \t]*export[ \t]*\*[ \t]*as[ \t]+([A-Za-z_$][\w$]*)[ \t]+from[ \t]+["'][^"']+["']/g;`,
  String.raw`const EXPORT_TYPE_LIST_RE = /(?:^|[;\n])[ \t]*export\s+type\s*\{([^}]*)\}/g;`,
  String.raw`const EXPORT_REEXPORT_RE = /(?:^|[;\n])[ \t]*export\s*\{([^}]*)\}\s*from\s*(["'])([^"']+)\2/g;`,
  String.raw`const EXPORT_LOCAL_RE = /(?:^|[;\n])[ \t]*export\s*\{([^}]*)\}(?!\s*from\b)/g;`,
  String.raw`const EXPORT_STAR_RE = /(?:^|[;\n])[ \t]*export\s*\*\s*from\s*(["'])([^"']+)\1/g;`,
  String.raw`const IMPORT_REWRITE_RE = /(^|[;\n])([ \t]*)import\s+(?:([A-Za-z_$][\w$]*)\s*,\s*)?\{([^}]*)\}\s*from\s*(["'])([^"']+)\5/g;`,
  String.raw`const REEXPORT_REWRITE_RE = /(^|[;\n])([ \t]*)export\s*\{([^}]*)\}\s*from\s*(["'])([^"']+)\4/g;`,
  String.raw`const LOCAL_EXPORT_REWRITE_RE = /(^|[;\n])([ \t]*)export\s*\{([^}]*)\}(?!\s*from\b)/g;`,
  'if (typeof mod.registerHooks === "function") {',
  '  const root = process.cwd();',
  '  const inside = (p) => p === root || p.startsWith(root + sep);',
  '  const isTsPath = (p) => TS_SUFFIXES.some((s) => p.endsWith(s));',
  '  const pickFile = (base) => {',
  '    if (!inside(base)) return null;',
  '    for (const suffix of SUFFIXES) {',
  '      const candidate = base + suffix;',
  '      if (inside(candidate) && statSync(candidate, { throwIfNoEntry: false })?.isFile()) return candidate;',
  '    }',
  '    if (JS_EXT_RE.test(base)) {',
  '      const stem = base.replace(JS_EXT_RE, "");',
  '      for (const suffix of TS_SUFFIXES) {',
  '        const candidate = stem + suffix;',
  '        if (inside(candidate) && statSync(candidate, { throwIfNoEntry: false })?.isFile()) return candidate;',
  '      }',
  '    }',
  '    return null;',
  '  };',
  '  let pkgName = null;',
  '  let pkgEntry = null;',
  '  try {',
  '    const pkg = JSON.parse(readFileSync(resolvePath(root, "package.json"), "utf8"));',
  '    if (typeof pkg.name === "string" && pkg.name.length > 0) {',
  '      pkgName = pkg.name;',
  '      const entries = ["src/index.ts", "src/index.mts", "src/index.cts", "src/index.tsx", "src/index.js", "src/index.mjs", "src/index.cjs", pkg.module, pkg.main, "index.ts", "index.mts", "index.cts", "index.tsx", "index.js", "index.mjs", "index.cjs"];',
  '      for (const entry of entries) {',
  '        if (typeof entry === "string" && entry.length > 0) {',
  '          const found = pickFile(resolvePath(root, entry));',
  '          if (found) { pkgEntry = found; break; }',
  '        }',
  '      }',
  '    }',
  '  } catch {}',
  '  const resolveLocal = (specifier, fromFile) => {',
  '    if (specifier.startsWith("./") || specifier.startsWith("../")) {',
  '      return pickFile(resolvePath(dirname(fromFile), specifier));',
  '    }',
  '    if (pkgName !== null && specifier === pkgName && pkgEntry !== null) return pkgEntry;',
  '    if (pkgName !== null && specifier.startsWith(pkgName + "/")) {',
  '      const sub = specifier.slice(pkgName.length + 1);',
  '      return pickFile(resolvePath(root, "src", sub)) ?? pickFile(resolvePath(root, sub));',
  '    }',
  '    return null;',
  '  };',
  '  const parseSpecifiers = (block) => {',
  String.raw`    const clean = block.replace(/\/\*[\s\S]*?\*\//g, "").replace(/\/\/[^\n]*/g, "");`,
  '    const items = [];',
  '    for (const part of clean.split(",")) {',
  '      const trimmed = part.trim();',
  '      if (!trimmed) continue;',
  '      const m = SPEC_RE.exec(trimmed);',
  '      if (m) items.push({ raw: trimmed, isType: Boolean(m[1]), orig: m[2], alias: m[3] ?? m[2] });',
  '      else items.push({ raw: trimmed, isType: false, orig: null, alias: null });',
  '    }',
  '    return items;',
  '  };',
  '  const collectLocalDecls = (src) => {',
  '    const localTypes = new Set();',
  '    const localValues = new Set();',
  '    for (const m of src.matchAll(LOCAL_TYPE_RE)) localTypes.add(m[1]);',
  '    for (const m of src.matchAll(LOCAL_VALUE_RE)) localValues.add(m[1]);',
  '    return { localTypes, localValues };',
  '  };',
  '  const exportCache = new Map();',
  '  const typeOnlyCache = new Map();',
  '  const analyzeExports = (targetPath, depth, seen) => {',
  '    if (exportCache.has(targetPath)) return exportCache.get(targetPath);',
  '    const empty = { types: new Set(), values: new Set() };',
  '    if (depth > 4 || seen.has(targetPath) || !inside(targetPath) || !isTsPath(targetPath)) return empty;',
  '    let raw;',
  '    try { raw = readFileSync(targetPath, "utf8"); } catch { return empty; }',
  '    const nextSeen = new Set(seen);',
  '    nextSeen.add(targetPath);',
  '    const types = new Set();',
  '    const values = new Set();',
  '    const { localTypes, localValues } = collectLocalDecls(raw);',
  '    for (const m of raw.matchAll(EXPORT_TYPE_DECL_RE)) types.add(m[1]);',
  '    for (const m of raw.matchAll(EXPORT_VALUE_DECL_RE)) values.add(m[1]);',
  '    if (EXPORT_DEFAULT_RE.test(raw)) values.add("default");',
  '    for (const m of raw.matchAll(EXPORT_NS_RE)) values.add(m[1]);',
  '    for (const m of raw.matchAll(EXPORT_TYPE_LIST_RE)) {',
  '      for (const item of parseSpecifiers(m[1])) { if (item.alias) types.add(item.alias); }',
  '    }',
  '    for (const m of raw.matchAll(EXPORT_REEXPORT_RE)) {',
  '      const sub = resolveLocal(m[3], targetPath);',
  '      const subInfo = sub && isTsPath(sub) ? analyzeExports(sub, depth + 1, nextSeen) : null;',
  '      for (const item of parseSpecifiers(m[1])) {',
  '        if (!item.orig || !item.alias) continue;',
  '        if (item.isType) types.add(item.alias);',
  '        else if (subInfo && subInfo.types.has(item.orig) && !subInfo.values.has(item.orig)) types.add(item.alias);',
  '        else values.add(item.alias);',
  '      }',
  '    }',
  '    for (const m of raw.matchAll(EXPORT_LOCAL_RE)) {',
  '      for (const item of parseSpecifiers(m[1])) {',
  '        if (!item.orig || !item.alias) continue;',
  '        if (item.isType || (localTypes.has(item.orig) && !localValues.has(item.orig))) types.add(item.alias);',
  '        else values.add(item.alias);',
  '      }',
  '    }',
  '    for (const m of raw.matchAll(EXPORT_STAR_RE)) {',
  '      const sub = resolveLocal(m[2], targetPath);',
  '      if (sub && isTsPath(sub)) {',
  '        const subInfo = analyzeExports(sub, depth + 1, nextSeen);',
  '        for (const t of subInfo.types) types.add(t);',
  '        for (const v of subInfo.values) values.add(v);',
  '      }',
  '    }',
  '    const result = { types, values };',
  '    if (depth === 0) exportCache.set(targetPath, result);',
  '    return result;',
  '  };',
  '  const getTypeOnlyExports = (targetPath) => {',
  '    if (typeOnlyCache.has(targetPath)) return typeOnlyCache.get(targetPath);',
  '    const { types, values } = analyzeExports(targetPath, 0, new Set());',
  '    const only = new Set();',
  '    for (const t of types) { if (!values.has(t)) only.add(t); }',
  '    typeOnlyCache.set(targetPath, only);',
  '    return only;',
  '  };',
  '  const rewriteTsSource = (stripped, raw, filePath) => {',
  '    const { localTypes, localValues } = collectLocalDecls(raw);',
  '    const droppedImports = new Set();',
  '    let out = stripped.replace(IMPORT_REWRITE_RE, (full, lead, indent, defName, block, quote, spec) => {',
  '      const target = resolveLocal(spec, filePath);',
  '      if (!target || !isTsPath(target)) return full;',
  '      const typeOnly = getTypeOnlyExports(target);',
  '      if (typeOnly.size === 0) return full;',
  '      const items = parseSpecifiers(block);',
  '      const kept = [];',
  '      for (const item of items) {',
  '        if (item.orig && typeOnly.has(item.orig)) { if (item.alias) droppedImports.add(item.alias); }',
  '        else kept.push(item);',
  '      }',
  '      if (kept.length === items.length) return full;',
      '      if (kept.length === 0) {',
      '        return defName ? lead + indent + "import " + defName + " from " + quote + spec + quote : lead + indent + "import " + quote + spec + quote;',
      '      }',
      '      const list = kept.map((i) => i.raw).join(", ");',
      '      return defName ? lead + indent + "import " + defName + ", { " + list + " } from " + quote + spec + quote : lead + indent + "import { " + list + " } from " + quote + spec + quote;',
      '    });',
      '    out = out.replace(REEXPORT_REWRITE_RE, (full, lead, indent, block, quote, spec) => {',
      '      const target = resolveLocal(spec, filePath);',
      '      if (!target || !isTsPath(target)) return full;',
      '      const typeOnly = getTypeOnlyExports(target);',
      '      if (typeOnly.size === 0) return full;',
      '      const items = parseSpecifiers(block);',
      '      const kept = items.filter((item) => !item.orig || !typeOnly.has(item.orig));',
      '      if (kept.length === items.length) return full;',
      '      if (kept.length === 0) return lead + indent;',
      '      return lead + indent + "export { " + kept.map((i) => i.raw).join(", ") + " } from " + quote + spec + quote;',
      '    });',
      '    out = out.replace(LOCAL_EXPORT_REWRITE_RE, (full, lead, indent, block) => {',
      '      const items = parseSpecifiers(block);',
      '      const kept = items.filter((item) => !item.orig || (!droppedImports.has(item.orig) && !(localTypes.has(item.orig) && !localValues.has(item.orig))));',
      '      if (kept.length === items.length) return full;',
      '      if (kept.length === 0) return lead + indent;',
      '      return lead + indent + "export { " + kept.map((i) => i.raw).join(", ") + " }";',
  '    });',
  '    return out;',
  '  };',
  '  mod.registerHooks({',
  '    resolve(specifier, context, nextResolve) {',
  '      try {',
  '        return nextResolve(specifier, context);',
  '      } catch (error) {',
  '        if ((specifier.startsWith("./") || specifier.startsWith("../")) && context.parentURL?.startsWith("file://")) {',
  '          const found = resolveLocal(specifier, fileURLToPath(context.parentURL));',
  '          if (found) return { shortCircuit: true, url: pathToFileURL(found).href };',
  '        }',
  '        if (pkgName !== null && (specifier === pkgName || specifier.startsWith(pkgName + "/"))) {',
  '          const found = resolveLocal(specifier, root);',
  '          if (found) return { shortCircuit: true, url: pathToFileURL(found).href };',
  '        }',
  '        throw error;',
  '      }',
  '    },',
  '    load(url, context, nextLoad) {',
  '      if (!url.startsWith("file://") || typeof mod.stripTypeScriptTypes !== "function") {',
  '        return nextLoad(url, context);',
  '      }',
  '      const filePath = fileURLToPath(url);',
  '      if (!inside(filePath) || !isTsPath(filePath)) return nextLoad(url, context);',
  '      let raw;',
  '      let stripped;',
  '      try {',
  '        raw = readFileSync(filePath, "utf8");',
  '        stripped = mod.stripTypeScriptTypes(raw, { mode: "strip" });',
  '      } catch {',
  '        return nextLoad(url, context);',
  '      }',
  '      const rewritten = rewriteTsSource(stripped, raw, filePath);',
  '      return { format: "module", shortCircuit: true, source: rewritten };',
  '    },',
  '  });',
  '}',
] as const;

const HOOK_SOURCE = HOOK_LINES.join('\n');
const HOOK_DATA_URL = `data:text/javascript,${encodeURIComponent(HOOK_SOURCE)}`;

/** Build the `--import` arguments enabling bounded extensionless relative, self-name, and type-elided ESM resolution. */
export function buildNodeResolveHookFlags(): readonly string[] {
  return ['--import', HOOK_DATA_URL];
}
